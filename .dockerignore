# Secrets and local config must never reach the image layer. The app reads
# DATABASE_URL from the process environment on Render, so nothing here is
# needed at runtime except as a local fallback.
.env
.env.local
.env.*.local

.git
.gitignore
.idea
.vs
node_modules
skills-lock.json
package.json
package-lock.json
neon.ts

# Not part of the served application.
# docker/ is deliberately NOT ignored: the Dockerfile copies docker/entrypoint.sh
# into the image, and excluding it from the build context makes the build fail
# with "COPY failed: no source files were specified".
README.md
schema.sql
Dockerfile
.dockerignore
render.yaml

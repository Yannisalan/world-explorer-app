# The document root is the repository root, so PHP sources and repo metadata sit
# next to the servable assets. Deny the former and the latter explicitly rather
# than relying on .dockerignore alone.
#
# Note: .php files must NOT be denied here. Every endpoint in this app is a
# top-level .php script under the document root, so denying the extension would
# take the whole application offline.

# Never serve dotfiles. Covers .env, .env.local, .git and .htaccess itself.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Deny by extension, not just by filename. The set of things a browser actually
# needs from this host is narrow and deliberate: .html, .css, .js, the .json
# files under data/, .webmanifest, .svg, .ico and fonts. Everything below is
# build tooling, local config or documentation that `COPY . /var/www/html` places
# under the document root but that no client ever requests.
#
# The previous rules named individual files, which meant anything added later
# silently became downloadable. docker/entrypoint.sh was the concrete case: it
# was served verbatim from the API host, handing over the container's start-up
# script. Naming the extension closes that class of leak for good.
<FilesMatch "\.(sh|bash|zsh|py|rb|pl|pm|cgi|ps1|bat|cmd|ini|conf|cnf|toml|lock|log|bak|sql|md|ts|map|txt|ya?ml)$">
    Require all denied
</FilesMatch>

# Extensionless files still need naming: the deny rule above cannot match them.
# schema.sql in particular would hand an attacker the full table layout.
<FilesMatch "^(Dockerfile|Makefile|Procfile|neon\.ts)$">
    Require all denied
</FilesMatch>

# Named files whose extension is otherwise servable. .json must stay allowed for
# data/, and .txt/.md are already covered above.
<FilesMatch "^(package\.json|package-lock\.json|skills-lock\.json)$">
    Require all denied
</FilesMatch>

# Source that is not an endpoint. These are include-only and would otherwise
# leak the DSN, the resolved theme, or the mail transport config when requested
# directly. Every other .php in the root is a real browser-facing endpoint.
<FilesMatch "^(config|user_theme|send_verification_email)\.php$">
    Require all denied
</FilesMatch>

# Assets are cache-busted with a ?v= query, so a long cache is safe for them.
# The worker and the manifest are excluded: caching those pins clients to a
# stale service worker, which is the one thing a PWA cannot recover from.
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>

    <Files "service-worker.js">
        Header set Cache-Control "no-cache, must-revalidate"
    </Files>

    <Files "manifest.webmanifest">
        Header set Cache-Control "no-cache, must-revalidate"
    </Files>
</IfModule>

# index.php is gone: the pages are static and are meant to be served from the
# frontend origin. The static files still sit in this document root so the API
# host can serve them too, which costs nothing and gives a same-origin fallback
# while the two hosts are being brought up.
DirectoryIndex index.html

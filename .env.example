# Copy to .env.local for local development, or set these in the Render
# dashboard for the deployed service. .env.local is gitignored and excluded
# from the Docker build, so real credentials never reach the image.

# --- Database ----------------------------------------------------------------
# Neon connection string for the production branch. Use the POOLED url for the
# running service; DATABASE_URL_UNPOOLED is only for migrations and psql.
# Host must start with ep- and the endpoint id is passed to libpq explicitly by
# pgsql_dsn_from_url() in config.php.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=production

# --- Public URLs -------------------------------------------------------------
# Base URL of THIS api, with no trailing slash. Used to build the emailed
# verification link, which must reach verify.php here rather than the static
# frontend. Example: https://world-explorer-api.onrender.com
APP_URL=

# Comma-separated list of origins allowed to call the API with credentials.
# Setting this switches the session cookie to SameSite=None; Secure, which is
# mandatory for a cross-site frontend. Leave empty for same-origin local work.
# Example: https://world-explorer-app.vercel.app,https://world-explorer-abc.vercel.app
FRONTEND_ORIGIN=

# --- Mapbox ------------------------------------------------------------------
# Public token used by get_country_images.php for street and satellite tiles.
MAPBOX_TOKEN=

# --- Outbound email (verification) -------------------------------------------
# A Gmail address with an app password works; any SMTP relay will do.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
